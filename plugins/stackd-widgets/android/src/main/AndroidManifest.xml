<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1.2.2 (HG-15 WG-4, docs/phone-widgets-plan.md §2): the home-screen
         widgets. Each one draws the app's snapshot (files/widgets/snapshot.json);
         the plugin asks them to redraw after every write. -->
    <application>
        <receiver android:name="com.stackd.widgets.BalancesWidget" android:exported="false" android:label="@string/stackd_widget_balances_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/stackd_widget_info_balances" />
        </receiver>
        <receiver android:name="com.stackd.widgets.FlowWidget" android:exported="false" android:label="@string/stackd_widget_flow_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/stackd_widget_info_flow" />
        </receiver>
        <receiver android:name="com.stackd.widgets.CategoriesWidget" android:exported="false" android:label="@string/stackd_widget_categories_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/stackd_widget_info_categories" />
        </receiver>
        <receiver android:name="com.stackd.widgets.BudgetsWidget" android:exported="false" android:label="@string/stackd_widget_budgets_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
