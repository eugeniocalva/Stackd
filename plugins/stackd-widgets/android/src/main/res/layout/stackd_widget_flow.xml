<?xml version="1.0" encoding="utf-8"?>
<!-- 1.2.2 (HG-15 WG-4): see docs/phone-widgets-plan.md §12 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/stackd_widget_bg"
    android:padding="14dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:textSize="14sp" android:textColor="@color/stackd_widget_text2"
    android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/stale" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="12sp" android:textColor="@color/stackd_widget_text3"
    android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
</LinearLayout>
<TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textSize="15sp" android:textColor="@color/stackd_widget_text2"
    android:maxLines="3" android:ellipsize="end" android:visibility="gone" />
<TextView android:id="@+id/headline" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="26sp" android:textColor="@color/stackd_widget_text" android:textStyle="bold"
    android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
<TextView android:id="@+id/caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="13sp" android:textColor="@color/stackd_widget_text2"
    android:maxLines="1" android:ellipsize="end" />
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:id="@+id/in_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/in_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:textSize="15sp" android:textColor="@color/stackd_widget_text2"
    android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/in_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="16sp" android:textColor="@color/stackd_widget_income" android:textStyle="bold"
    android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<ImageView android:id="@+id/in_bar" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:layout_marginBottom="6dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout android:id="@+id/out_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/out_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:textSize="15sp" android:textColor="@color/stackd_widget_text2"
    android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/out_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="16sp" android:textColor="@color/stackd_widget_expense" android:textStyle="bold"
    android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<ImageView android:id="@+id/out_bar" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
</LinearLayout>
