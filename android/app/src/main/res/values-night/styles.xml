<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- v0.96: owner's call — the launch is a WHITE page with the black
         lockup in every appearance, on both platforms (overrides the v0.81
         dark-splash variant; the splash imagery itself is identical to the
         light one now, so a dark background here would clash). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_stackd</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
