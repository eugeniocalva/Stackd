# Copy to android/keystore.properties (gitignored) and fill in.
#
# Create the UPLOAD key once — Google Play App Signing holds the real signing
# key, so losing this one only needs an upload-key reset, not a new app:
#
#   keytool -genkeypair -v -keystore stackd-upload.jks -alias upload \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the .jks OUTSIDE this repository (it is public) and back it up: a
# password manager entry plus one offline copy. storeFile is resolved
# relative to the android/ directory, so an absolute path is safest.
storeFile=C:/Users/<you>/keys/stackd-upload.jks
storePassword=
keyAlias=upload
keyPassword=
