{
  "name": "stackd-broker",
  "version": "0.1.0",
  "private": true,
  "description": "Stack'd Bank Connect broker — Cloudflare Worker between the app and Enable Banking (docs/bank-connect-plan.md)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy",
    "preflight": "node scripts/preflight.mjs",
    "predeploy:production": "node scripts/preflight.mjs",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  }
}
